{
 "model": {
  "type": "minecraft:select",
  "property": "minecraft:custom_model_data",
  "index": 0,
  "cases": [
   {
    "when": "iron",
    "model": {
     "type": "minecraft:model",
     "model": "happyghastplus:item/ghast_visor_iron"
    }
   },
   {
    "when": "diamond",
    "model": {
     "type": "minecraft:model",
     "model": "happyghastplus:item/ghast_visor_diamond"
    }
   },
   {
    "when": "netherite",
    "model": {
     "type": "minecraft:model",
     "model": "happyghastplus:item/ghast_visor_netherite"
    }
   }
  ],
  "fallback": {
   "type": "minecraft:model",
   "model": "happyghastplus:item/ghast_visor_iron"
  }
 }
}

{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "none",
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:custom_model_data",
          "index": 0,
          "on_true": {
            "type": "minecraft:model",
            "model": "happyghastplus:item/ghast_rocket_engine_lit"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "happyghastplus:item/ghast_rocket_engine"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "happyghastplus:item/ghast_speed_upgrade"
    }
  }
}
